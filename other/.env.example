# Copy these settings into the local .env file. Keep the real Atlas URI private.
MONGODB_URI=
MONGODB_DATABASE=devcompass
MONGODB_VECTOR_COLLECTION=document_chunks
MONGODB_VECTOR_INDEX=devcompass_vector

# Set at least one provider key to enable AI-generated answers.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=